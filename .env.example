# Public playlist URL (the API extracts its list= ID). The header link points here too.
NEXT_PUBLIC_YOUTUBE_PLAYLIST_URL=https://www.youtube.com/playlist?list=YOUR_PLAYLIST_ID

# Server-only YouTube Data API v3 key. Restrict it to the YouTube Data API in Google Cloud.
YOUTUBE_DATA_API_KEY=your-youtube-data-api-key

# Optional. Canonical origin, used to resolve absolute Open Graph URLs.
# Leave unset on Vercel — the production URL is picked up automatically.
# NEXT_PUBLIC_SITE_URL=https://tempo.fm
